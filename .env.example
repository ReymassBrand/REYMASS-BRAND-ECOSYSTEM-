# REYMASS ONE - Example Environment Configuration
# Copy this file to .env and replace placeholders with your actual settings.
# Never commit .env or real credentials.

PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Database
DB_CLIENT=sqlite3
DB_FILENAME=./dev.sqlite3

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
MPESA_SHORTCODE=your_sandbox_shortcode
MPESA_PASSKEY=your_sandbox_passkey
MPESA_CALLBACK_URL=https://your-public-callback-url.example.com/api/mpesa/callback
